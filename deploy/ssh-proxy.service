[Unit]
Description=Restricted SSH proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sshproxy
Group=sshproxy
ExecStart=/usr/local/bin/ssh-proxy serve -c /etc/ssh-proxy/config.yaml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
